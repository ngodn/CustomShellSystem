+// Editor-only integration probe. The authored graph uses shipped engine nodes.
+#include "Animation/PoseSnapshot.h"
+#include "Animation/AnimCurveMetadata.h"
+#include "Animation/MorphTarget.h"
+#include "JsonObjectConverter.h"
+
+USkeletalMesh* UCSSControlRigLibrary::CreateMorphMetadataCandidate(USkeletalMesh* Mesh,const FString& PackagePath)
+{
+    if (!IsRunningCommandlet() || !Mesh ||
+        !Mesh->GetPathName().StartsWith(TEXT("/Game/CSSAuthoring/DiagnosticReferences/")) ||
+        !PackagePath.StartsWith(TEXT("/Game/CSSAuthoring/DiagnosticReferences/")) ||
+        FPackageName::DoesPackageExist(PackagePath)) return nullptr;
+    auto* Candidate=Cast<USkeletalMesh>(StaticDuplicateObject(Mesh,CreatePackage(*PackagePath),
+        FName(*FPackageName::GetLongPackageAssetName(PackagePath))));
+    if (!Candidate) return nullptr;
+    auto* Metadata=Candidate->GetAssetUserData<UAnimCurveMetaData>();
+    if (!Metadata)
+    {
+        Metadata=NewObject<UAnimCurveMetaData>(Candidate,NAME_None,RF_Public);
+        Candidate->AddAssetUserData(Metadata);
+    }
+    for (const auto& Morph : Candidate->GetMorphTargets())
+    {
+        Metadata->AddCurveMetaData(Morph->GetFName(),false);
+        Metadata->SetCurveMetaDataMorphTarget(Morph->GetFName(),true);
+    }
+    FSavePackageArgs Save;Save.TopLevelFlags=RF_Public|RF_Standalone;Save.SaveFlags=SAVE_NoError;
+    return UPackage::SavePackage(Candidate->GetOutermost(),Candidate,
+        *FPackageName::LongPackageNameToFilename(PackagePath,FPackageName::GetAssetPackageExtension()),Save) ? Candidate : nullptr;
+}
+
+UAnimBlueprint* UCSSControlRigLibrary::CreateHandPostProcessCandidate(USkeletalMesh* Mesh,
+    UAnimBlueprint* Baseline, UControlRigBlueprint* HandRig, const FString& PackagePath,
+    const TArray<FName>& HandBones, const TArray<FName>& Curves)
+{
+    auto Fail=[](const TCHAR* Why)->UAnimBlueprint* {
+        UE_LOG(LogCSSControlRig,Error,TEXT("Hand integration: %s"),Why);return nullptr;
+    };
+    if (!IsRunningCommandlet() || !Mesh || !Mesh->GetSkeleton() || !Baseline || !Baseline->GeneratedClass ||
+        !HandRig || !HandRig->GeneratedClass || !HandRig->GeneratedClass->IsChildOf(UControlRig::StaticClass()) ||
+        !Mesh->GetPathName().StartsWith(TEXT("/Game/CSSAuthoring/DiagnosticReferences/")) ||
+        !HandRig->GetPathName().StartsWith(TEXT("/Game/CSSAuthoring/TransientProbes/")) ||
+        !PackagePath.StartsWith(TEXT("/Game/CSS/TransientProbes/ABP_CSS_ControlRigProbeHand")) ||
+        FPackageName::DoesPackageExist(PackagePath) || HandBones.Num()!=19 || Curves.Num()!=16)
+        return Fail(TEXT("Invalid isolated asset contract"));
+    TSet<FName> Seen;
+    for (FName Name : HandBones)
+    {
+        const FString Text=Name.ToString();
+        if (Seen.Contains(Name) || !Text.EndsWith(TEXT("_l")) ||
+            !(Text.StartsWith(TEXT("thumb_")) || Text.StartsWith(TEXT("index_")) ||
+              Text.StartsWith(TEXT("middle_")) || Text.StartsWith(TEXT("ring_")) || Text.StartsWith(TEXT("pinky_"))) ||
+            Mesh->GetRefSkeleton().FindBoneIndex(Name)==INDEX_NONE) return Fail(TEXT("Invalid hand output bone"));
+        Seen.Add(Name);
+    }
+    Seen.Reset();
+    for (FName Curve : Curves)
+    {
+        if (Seen.Contains(Curve) || !Mesh->FindMorphTarget(Curve)) return Fail(TEXT("Missing private hand morph"));
+        Seen.Add(Curve);
+    }
+    for (const TCHAR* Name : {TEXT("Enabled"),TEXT("InputIsV43Compatible")})
+        if (!FindFProperty<FBoolProperty>(HandRig->GeneratedClass.Get(),Name)) return Fail(TEXT("Missing hand input"));
+    auto* Blueprint=Cast<UAnimBlueprint>(StaticDuplicateObject(Baseline,CreatePackage(*PackagePath),
+        FName(*FPackageName::GetLongPackageAssetName(PackagePath))));
+    if (!Blueprint) return Fail(TEXT("Cannot duplicate accepted body/hair graph"));
+    Blueprint->TargetSkeleton=Mesh->GetSkeleton();
+    FEdGraphPinType BoolType;BoolType.PinCategory=UEdGraphSchema_K2::PC_Boolean;
+    for (const TCHAR* Name : {TEXT("CSSHandEnabled"),TEXT("CSSHandInputIsV43Compatible")})
+        if (!FBlueprintEditorUtils::AddMemberVariable(Blueprint,Name,BoolType,TEXT("false")))
+            return Fail(TEXT("Cannot add hand control"));
+    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
+    UEdGraph* Graph=nullptr;
+    for (auto Candidate : Blueprint->FunctionGraphs)
+        if (Candidate->GetFName()==TEXT("AnimGraph")) Graph=Candidate.Get();
+    if (!Graph) return Fail(TEXT("Missing copied AnimGraph"));
+    UAnimGraphNode_Root* Root=nullptr;int32 ExistingRigs=0;
+    for (auto Node : Graph->Nodes)
+    {
+        if (auto* Candidate=Cast<UAnimGraphNode_Root>(Node)) Root=Candidate;
+        if (Cast<UAnimGraphNode_ControlRig>(Node)) ++ExistingRigs;
+    }
+    if (!Root || ExistingRigs!=2 || Root->FindPinChecked(TEXT("Result"))->LinkedTo.Num()!=1)
+        return Fail(TEXT("Expected accepted two-rig pose path"));
+    auto* Previous=Root->FindPinChecked(TEXT("Result"))->LinkedTo[0];
+    auto* Node=NewGraphNode<UAnimGraphNode_ControlRig>(Graph);
+    Node->Node.SetControlRigClass(HandRig->GeneratedClass.Get());Node->AllocateDefaultPins();
+    for (const auto& Pair : {TPair<FName,bool>(TEXT("bResetInputPoseToInitial"),true),
+                            TPair<FName,bool>(TEXT("bTransferInputPose"),true),
+                            TPair<FName,bool>(TEXT("bTransferInputCurves"),true),
+                            TPair<FName,bool>(TEXT("bTransferPoseInGlobalSpace"),false)})
+    {
+        auto* Property=FindFProperty<FBoolProperty>(FAnimNode_ControlRigBase::StaticStruct(),Pair.Key);
+        if (!Property) return Fail(TEXT("Missing pose transfer flag"));
+        Property->SetPropertyValue_InContainer(&Node->Node,Pair.Value);
+    }
+    auto* CustomPins=FindFProperty<FArrayProperty>(Node->GetClass(),TEXT("CustomPinProperties"));
+    auto* Filter=FindFProperty<FArrayProperty>(FAnimNode_ControlRigBase::StaticStruct(),TEXT("OutputBonesToTransfer"));
+    if (!CustomPins || !Filter) return Fail(TEXT("Missing native transfer metadata"));
+    auto& Options=*CustomPins->ContainerPtrToValuePtr<TArray<FOptionalPinFromProperty>>(Node);
+    for (auto& Option : Options)
+        Option.bShowPin=Option.PropertyName==TEXT("Enabled") || Option.PropertyName==TEXT("InputIsV43Compatible");
+    Node->ReconstructNode();
+    for (const auto& Pair : {TPair<FName,FName>(TEXT("CSSHandEnabled"),TEXT("Enabled")),
+                            TPair<FName,FName>(TEXT("CSSHandInputIsV43Compatible"),TEXT("InputIsV43Compatible"))})
+    {
+        auto* Read=VariableRead(Graph,Pair.Key);
+        if (!Link(Graph,Read->FindPin(Pair.Key),Node->FindPin(Pair.Value))) return Fail(TEXT("Cannot link hand control"));
+    }
+    auto& Output=*Filter->ContainerPtrToValuePtr<TArray<FBoneReference>>(&Node->Node);
+    for (FName Name : HandBones) { FBoneReference Bone;Bone.BoneName=Name;Output.Add(Bone); }
+    Root->FindPinChecked(TEXT("Result"))->BreakAllPinLinks();
+    if (!Link(Graph,Previous,Node->FindPin(TEXT("Source"))) ||
+        !Link(Graph,Node->FindPin(TEXT("Pose")),Root->FindPin(TEXT("Result")))) return Fail(TEXT("Cannot append hand pose"));
+    FBlueprintEditorUtils::MarkBlueprintAsStructurallyModified(Blueprint);
+    FCompilerResultsLog Results;
+    FKismetEditorUtilities::CompileBlueprint(Blueprint,EBlueprintCompileOptions::None,&Results);
+    if (Results.NumErrors || Results.NumWarnings || !Blueprint->GeneratedClass || Blueprint->Status==BS_Error)
+        return Fail(TEXT("Candidate compilation failed"));
+    FSavePackageArgs Save;Save.TopLevelFlags=RF_Public|RF_Standalone;Save.SaveFlags=SAVE_NoError;
+    if (!UPackage::SavePackage(Blueprint->GetOutermost(),Blueprint,
+        *FPackageName::LongPackageNameToFilename(PackagePath,FPackageName::GetAssetPackageExtension()),Save))
+        return Fail(TEXT("Candidate save failed"));
+    return Blueprint;
+}
