                     return Fail(TEXT("Cannot export complete body region defaults"));
                 BodyInputs.Add({FName(Name),FName(*(FString(TEXT("CSSBody"))+Name)),Category,Default,true});
             }
+            // Travel in degrees (BodyAngularV11 and later). 0 keeps the rig's own
+            // Limits/MaxTravel. Older rigs have neither member and get neither input;
+            // the native adapter treats that pair as absent. A half pair is refused.
+            auto* RegionTravel=FindFProperty<FArrayProperty>(BodyBlueprint->GeneratedClass.Get(),TEXT("RegionTravel"));
+            auto* Travel=FindFProperty<FFloatProperty>(BodyBlueprint->GeneratedClass.Get(),TEXT("Travel"));
+            if ((RegionTravel==nullptr)!=(Travel==nullptr)) return Fail(TEXT("Body travel inputs must exist together"));
+            if (RegionTravel)
+            {
+                if (RegionTravel->ArrayDim!=1 || !CastField<FFloatProperty>(RegionTravel->Inner))
+                    return Fail(TEXT("Body region travel must be a float array"));
+                FScriptArrayHelper Values(RegionTravel,RegionTravel->ContainerPtrToValuePtr<void>(Defaults));
+                if (Values.Num()!=BodyNames.Num()) return Fail(TEXT("Body region travel must contain seven values"));
+                FString Default;
+                if (!RegionTravel->ExportText_InContainer(0,Default,Defaults,nullptr,Defaults,PPF_None) || Default.IsEmpty())
+                    return Fail(TEXT("Cannot export body region travel defaults"));
+                const float Global=Travel->GetPropertyValue_InContainer(Defaults);
+                if (!FMath::IsFinite(Global) || Global<0) return Fail(TEXT("Invalid body travel default"));
+                BodyInputs.Add({TEXT("RegionTravel"),TEXT("CSSBodyRegionTravel"),UEdGraphSchema_K2::PC_Real,Default,true});
+                BodyInputs.Add({TEXT("Travel"),TEXT("CSSBodyTravel"),UEdGraphSchema_K2::PC_Real,FString::SanitizeFloat(Global)});
+            }
+            // Soft limit band (RegionSoftZones/SoftZone, a fraction of the travel), the same
+            // rules: both or neither, defaults copied from the rig so an untouched AnimBP
+            // runs the rig's own band.
+            auto* RegionZones=FindFProperty<FArrayProperty>(BodyBlueprint->GeneratedClass.Get(),TEXT("RegionSoftZones"));
+            auto* Zone=FindFProperty<FFloatProperty>(BodyBlueprint->GeneratedClass.Get(),TEXT("SoftZone"));
