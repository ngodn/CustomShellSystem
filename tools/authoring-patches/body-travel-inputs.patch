             Inner->SetPropertyValue(Values.GetRawPtr(0),Mode!=TEXT("region_off") &&
                 !(Mode==TEXT("region_reenable") && Frame>=Fps && Frame<3*Fps/2));
         }
+        // Travel pair, with the exact property facts the native adapter requires:
+        // a float array of seven and a float scalar, both present or both absent.
+        auto* RegionTravel=FindFProperty<FArrayProperty>(Instance->GetClass(),TEXT("CSSBodyRegionTravel"));
