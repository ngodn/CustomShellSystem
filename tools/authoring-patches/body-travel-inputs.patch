+                if (!Variable || !Scalar || !RegionTravel->SameType(Variable) ||
+                    !RegionTravel->Identical(RegionTravel->ContainerPtrToValuePtr<void>(Instance),Variable->ContainerPtrToValuePtr<void>(BodyRig),PPF_None) ||
+                    GlobalTravel->GetPropertyValue_InContainer(Instance)!=Scalar->GetPropertyValue_InContainer(BodyRig))
+                    return Fail(TEXT("Combined body travel transfer differs"));
+                Inputs->SetStringField(TEXT("RegionTravel"),BodyRig->GetVariableAsString(TEXT("RegionTravel")));
