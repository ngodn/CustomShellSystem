+{
+bool Diagnostic(const UObject* Object)
+{
+    return IsRunningCommandlet() && Object &&
+        Object->GetPathName().StartsWith(TEXT("/Game/CSSAuthoring/DiagnosticReferences/"));
+}
+
+bool Import(const TSharedRef<FJsonObject>& Json, const UStruct* Type, void* Value)
+{
+    FText Reason;
+    const bool Ok = FJsonObjectConverter::JsonObjectToUStruct(Json, Type, Value, 0,
+        CPF_Transient | CPF_Deprecated, false, &Reason);
+    if (!Ok) UE_LOG(LogTemp, Error, TEXT("CSS body import: %s"), *Reason.ToString());
+    return Ok;
+}
+
+TSharedRef<FJsonObject> Export(const UStruct* Type, const void* Value)
+{
+    auto Json = MakeShared<FJsonObject>();
+    check(FJsonObjectConverter::UStructToJsonObject(Type, Value, Json, 0, CPF_Transient | CPF_Deprecated));
+    return Json;
+}
+
+FString Text(const TSharedRef<FJsonObject>& Value)
+{
+    FString Result;
+    return FJsonSerializer::Serialize(Value, TJsonWriterFactory<>::Create(&Result)) ? Result : FString();
+}
+}
+
+UPhysicsAsset* UCSSPhysicsProbeLibrary::CreateBodyCandidate(USkeletalMesh* Mesh,
+    const FString& DefinitionJson, const FString& PackagePath)
+{
+    if (!Diagnostic(Mesh) || Mesh->GetRefSkeleton().GetRawBoneNum() != 379 ||
+        !PackagePath.StartsWith(TEXT("/Game/CSSAuthoring/DiagnosticReferences/PA_B2BodyFit")) ||
+        !FPackageName::IsValidLongPackageName(PackagePath) ||
+        FindPackage(nullptr, *PackagePath) || FPackageName::DoesPackageExist(PackagePath)) return nullptr;
+    TSharedPtr<FJsonObject> Json;
+    if (!FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(DefinitionJson), Json)) return nullptr;
+    const auto& Bodies = Json->GetArrayField(TEXT("bodies"));
+    const auto& Constraints = Json->GetArrayField(TEXT("constraints"));
+    if (Bodies.Num() != 22 || Constraints.Num() != 21 || !Json->GetBoolField(TEXT("neutral_vertex_fit"))) return nullptr;
+    UPhysicsAsset* Asset = NewObject<UPhysicsAsset>(CreatePackage(*PackagePath),
+        *FPackageName::GetLongPackageAssetName(PackagePath), RF_Public | RF_Standalone);
+    TSet<FName> Names;
+    for (const auto& Row : Bodies)
+    {
+        USkeletalBodySetup* Body = NewObject<USkeletalBodySetup>(Asset, NAME_None, RF_Transactional);
+        if (!Import(Row->AsObject().ToSharedRef(), USkeletalBodySetup::StaticClass(), Body) ||
+            Body->BoneName.IsNone() || Names.Contains(Body->BoneName) ||
+            Mesh->GetRefSkeleton().FindBoneIndex(Body->BoneName) == INDEX_NONE ||
+            Body->PhysicsType != PhysType_Default || Body->AggGeom.GetElementCount() < 1) return nullptr;
+        Names.Add(Body->BoneName);
+        Body->InvalidatePhysicsData();
+        Body->CreatePhysicsMeshes();
+        Asset->SkeletalBodySetups.Add(Body);
+    }
+    for (const auto& Row : Constraints)
+    {
+        UPhysicsConstraintTemplate* Constraint = NewObject<UPhysicsConstraintTemplate>(Asset, NAME_None, RF_Transactional);
+        if (!Import(Row->AsObject().ToSharedRef(), UPhysicsConstraintTemplate::StaticClass(), Constraint) ||
+            !Names.Contains(Constraint->DefaultInstance.ConstraintBone1) ||
+            !Names.Contains(Constraint->DefaultInstance.ConstraintBone2)) return nullptr;
+        // Serialize saves DefaultProfile, so synchronize it before any save/cook.
+        Constraint->UpdateProfileInstance();
+        Asset->ConstraintSetup.Add(Constraint);
+    }
+    if (!Import(Json->GetObjectField(TEXT("solver_settings")).ToSharedRef(),
+        FPhysicsAssetSolverSettings::StaticStruct(), &Asset->SolverSettings)) return nullptr;
+    for (const auto& Value : Json->GetArrayField(TEXT("collision_disable_table")))
+    {
+        const auto Row = Value->AsObject();
+        const auto Indices = Row->GetArrayField(TEXT("indices"));
+        if (Indices.Num() != 2) return nullptr;
+        const int32 A = Indices[0]->AsNumber(), B = Indices[1]->AsNumber();
+        if (A < 0 || B <= A || B >= Bodies.Num()) return nullptr;
+        Asset->CollisionDisableTable.Add(FRigidBodyIndexPair(A, B), Row->GetBoolField(TEXT("value")));
+    }
+    Asset->UpdateBodySetupIndexMap();
+    Asset->UpdateBoundsBodiesArray();
+    Asset->PreviewSkeletalMesh = Mesh;
+    Asset->MarkPackageDirty();
+    return Asset;
+}
+
+FString UCSSPhysicsProbeLibrary::InspectBodyCandidate(UPhysicsAsset* Asset)
+{
+    if (!Diagnostic(Asset)) return {};
+    auto Report = MakeShared<FJsonObject>();
+    TArray<TSharedPtr<FJsonValue>> Bodies, Constraints, Pairs, Bounds;
+    for (const auto& Body : Asset->SkeletalBodySetups)
+        Bodies.Add(MakeShared<FJsonValueObject>(Export(USkeletalBodySetup::StaticClass(), Body)));
+    for (const auto& Constraint : Asset->ConstraintSetup)
+        Constraints.Add(MakeShared<FJsonValueObject>(Export(UPhysicsConstraintTemplate::StaticClass(), Constraint)));
+    for (const auto& Pair : Asset->CollisionDisableTable)
+    {
+        auto Row = MakeShared<FJsonObject>();
+        Row->SetArrayField(TEXT("indices"), {MakeShared<FJsonValueNumber>(Pair.Key.Indices[0]),
+            MakeShared<FJsonValueNumber>(Pair.Key.Indices[1])});
+        Row->SetBoolField(TEXT("value"), Pair.Value);
+        Pairs.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    for (int32 Index : Asset->BoundsBodies) Bounds.Add(MakeShared<FJsonValueNumber>(Index));
+    Report->SetArrayField(TEXT("bodies"), Bodies);
+    Report->SetArrayField(TEXT("constraints"), Constraints);
+    Report->SetArrayField(TEXT("collision_disable_table"), Pairs);
+    Report->SetArrayField(TEXT("bounds_bodies"), Bounds);
+    Report->SetObjectField(TEXT("solver_settings"), Export(FPhysicsAssetSolverSettings::StaticStruct(), &Asset->SolverSettings));
+    return Text(Report);
+}
