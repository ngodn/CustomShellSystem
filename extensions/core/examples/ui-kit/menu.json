{
  "schema": 1,
  "sections": [
    {
      "id": "inputs",
      "title": "Inputs",
      "controls": [
        {
          "id": "enabled",
          "type": "toggle",
          "label": "Toggle",
          "value": false,
          "description": "An on/off setting. Select it, then press Confirm or click its action."
        },
        {
          "id": "quality",
          "type": "radio",
          "label": "Radio group",
          "value": "balanced",
          "options": [
            {
              "id": "quiet",
              "label": "Quiet"
            },
            {
              "id": "balanced",
              "label": "Balanced"
            },
            {
              "id": "strong",
              "label": "Strong"
            }
          ],
          "description": "Choose one option. Click an option, or use Left / Right while this setting is selected."
        },
        {
          "id": "strength",
          "type": "slider",
          "label": "Slider",
          "value": 50,
          "min": 0,
          "max": 100,
          "step": 5,
          "description": "Drag to adjust. The value is committed when you release the mouse. Left / Right changes one step."
        },
        {
          "id": "count",
          "type": "number",
          "label": "Number stepper",
          "value": 4,
          "min": 1,
          "max": 16,
          "step": 1,
          "description": "A bounded numeric value with consistent steps."
        },
        {
          "id": "theme",
          "type": "choice",
          "label": "Option selector",
          "value": "gold",
          "options": [
            {
              "id": "gold",
              "label": "Gold"
            },
            {
              "id": "silver",
              "label": "Silver"
            },
            {
              "id": "bronze",
              "label": "Bronze"
            }
          ],
          "description": "Cycle through named options. Their labels are shown instead of internal IDs."
        },
