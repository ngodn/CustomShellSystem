 #include "CSSDynamicsProbe.inl"
 #include "CSSDynamicsControlsProbe.inl"
+
+
+FString UCSSRetargetLibrary::InspectMeshMaterials(USkeletalMesh* Mesh)
+{
+    if (!IsRunningCommandlet() || !Mesh) return {};
+    TArray<TSharedPtr<FJsonValue>> Rows;
+    for (const FSkeletalMaterial& Slot : Mesh->GetMaterials())
+    {
+        auto Row = MakeShared<FJsonObject>();
+        Row->SetStringField(TEXT("name"), Slot.MaterialSlotName.ToString());
+        Row->SetStringField(TEXT("imported"), Slot.ImportedMaterialSlotName.ToString());
+        Row->SetStringField(TEXT("material"), GetPathNameSafe(Slot.MaterialInterface));
+        Row->SetStringField(TEXT("overlay"), GetPathNameSafe(Slot.OverlayMaterialInterface));
+        Row->SetBoolField(TEXT("initialized"), Slot.UVChannelData.bInitialized);
+        Row->SetBoolField(TEXT("override_densities"), Slot.UVChannelData.bOverrideDensities);
+        TArray<TSharedPtr<FJsonValue>> Densities;
+        for (float Density : Slot.UVChannelData.LocalUVDensities)
+            Densities.Add(MakeShared<FJsonValueNumber>(Density));
+        Row->SetArrayField(TEXT("uv_densities"), Densities);
+        Rows.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    FString Result;
+    return FJsonSerializer::Serialize(Rows, TJsonWriterFactory<>::Create(&Result)) ? Result : FString();
+}
