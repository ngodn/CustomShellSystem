module CSSX

schema: Int = 1
sections: Listing<Section>

class Option {
  id: String
  label: String
}
open class Control {
  id: String
  label: String
  type: "button"|"toggle"|"number"|"choice"|"text"|"label"|"radio"|"slider"|"progress"|"loading"
  description: String = ""
  enabled: Boolean = true
  busy: Boolean = false
  value: (Boolean|Number|String)? = null
}
class Toggle extends Control {
  type = "toggle"
  value: Boolean = false
}
class Button extends Control {
  type = "button"
}
open class NumberControl extends Control {
  type = "number"
  min: Number
  max: Number
  step: Number
  value: Number
}
open class Choice extends Control {
  type = "choice"
  options: Listing<Option>
  value: String
}
class Section {
  id: String
  title: String
  controls: Listing<Control>
}

class Slider extends NumberControl {
  type = "slider"
}
class RadioGroup extends Choice {
  type = "radio"
}
class ProgressBar extends Control {
  type = "progress"
  value: Number = 0
}
class Loading extends Control {
  type = "loading"
  value: Boolean = true
}
class TextInput extends Control {
  type = "text"
  value: String = ""
}
