// No windows.h: the resource compiler runs without the SDK include path under
// the cross toolchain, so the few constants it needs are spelled out.
#define RT_MANIFEST 24
#define VS_VERSION_INFO 1
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L
1 RT_MANIFEST "wcmg.manifest"
// Icon 1 is the window and exe icon; resource 2 (type 10, RCDATA) is the empty-state artwork.
#define WCMG_RT_RCDATA 10
1 ICON "../../assets/wcmg.ico"
2 WCMG_RT_RCDATA "../../assets/wcmg-meme-1280.png"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "eins0fx"
      VALUE "FileDescription", "Who Crashed My Game: Mortal Shell II crash diagnostics"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "WCMG"
      VALUE "OriginalFilename", "WCMG.exe"
      VALUE "ProductName", "Who Crashed My Game"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
