# Local dependencies, extracted assets, packages and development evidence.
/build/
/work/
/backups/
/local-packs/
reference/
/ue4ss/
/dist/
/output/
/tmp/

# Runtime state and developer catalogs are specific to an installation.
/scratch/
/state/
/runtime/
/logs/
/cache/
/cores/
/catalog/*.json
/catalog/*.disabled
/docs/development/non-css-modding-guide/
# The one exception: a dev fixture that exercises the 1.0 control kinds against an
# installed mesh, so a toggle, a texture choice and a pair of spring sliders can be seen
# in game without cooking a package. It ships with nothing.
!/catalog/dev-control-kinds.css.json

# Python environments and caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# C++, CMake and .NET build products.
bin/
obj/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.dll
*.exe
*.pdb
*.obj
*.o
*.a
*.lib
*.so
*.so.*

# Cooked game content and diagnostics never belong in the source repository.
*.pak
*.utoc
*.ucas
*.uasset
*.uexp
*.ubulk
*.uptnl
*.usmap
*.dmp
*.log

# Machine secrets and editor state. Keep shareable example configuration.
.env
.env.*
!.env.example
*.pem
*.key
.vs/
.idea/
.vscode/
*.user
*.suo
*.swp
*~
.DS_Store
Thumbs.db

# Offline Unreal authoring project: track source/configuration, never local assets.
/tools/authoring/CSSAuthoring/Binaries/
/tools/authoring/CSSAuthoring/Intermediate/
/tools/authoring/CSSAuthoring/Saved/
/tools/authoring/CSSAuthoring/DerivedDataCache/
/tools/authoring/CSSAuthoring/Build/
/tools/authoring/CSSAuthoring/Content/
/tools/authoring/CSSAuthoring/.vs/
/tools/authoring/CSSAuthoring/*.sln
/tools/authoring/CSSAuthoring/*.code-workspace
