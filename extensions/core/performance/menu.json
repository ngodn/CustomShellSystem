    {
      "id": "scalability",
      "title": "Scalability",
      "description": "The game's own quality groups, applied at once. Watch the fps in the status line after each change.",
      "controls": [
        {
          "id": "shadow",
          "label": "Shadows",
          "type": "choice",
          "description": "sg.ShadowQuality. Virtual shadow maps are usually the single most expensive setting in UE5; High to Medium is the first thing to try.",
          "value": "2",
          "options": [
            {
              "id": "0",
              "label": "Low"
            },
            {
              "id": "1",
              "label": "Medium"
            },
            {
              "id": "2",
              "label": "High"
            },
            {
              "id": "3",
              "label": "Epic"
            },
            {
              "id": "4",
              "label": "Cinematic"
            }
          ],
          "hint": "Biggest single GPU cost"
        },
        {
          "id": "gi",
          "label": "Global illumination",
          "type": "choice",
          "description": "sg.GlobalIlluminationQuality. Lumen GI quality. Medium keeps Lumen with cheaper traces.",
          "value": "2",
          "options": [
            {
              "id": "0",
              "label": "Low"
            },
            {
              "id": "1",
              "label": "Medium"
