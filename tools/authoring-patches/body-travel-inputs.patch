+                Inputs->SetStringField(TEXT("ClampContacts"),BodyRig->GetVariableAsString(TEXT("ClampContacts")));
+            }
             const bool Active=BodyRig->GetVariableAsString(TEXT("UseRegionSettings")).Equals(TEXT("True"),ESearchCase::IgnoreCase);
             if (Active!=RegionMode) return Fail(TEXT("Combined region switch transfer differs"));
