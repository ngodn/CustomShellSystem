+bool UCSSRetargetLibrary::BindDiagnosticMeshSkeleton(USkeletalMesh* Mesh, USkeleton* Skeleton)
+{
+    const FString Prefix = TEXT("/Game/CSSAuthoring/DiagnosticReferences/");
+    if (!Mesh || !Skeleton || !Mesh->GetPathName().StartsWith(Prefix) ||
+        !Skeleton->GetPathName().StartsWith(Prefix)) return false;
+    Mesh->SetSkeleton(Skeleton);
+    return Mesh->GetSkeleton() == Skeleton;
 }
 
