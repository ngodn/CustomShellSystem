+
+bool UCSSControlRigLibrary::ConfigureHandCandidateDefaults(UAnimBlueprint* Blueprint)
+{
+    if (!IsRunningCommandlet() || !Blueprint || !Blueprint->GeneratedClass ||
+        !Blueprint->GetPathName().StartsWith(TEXT("/Game/CSS/TransientProbes/ABP_CSS_ControlRigProbeHand"))) return false;
+    const TMap<FName,FString> Defaults = {{TEXT("CSSStiffness"),TEXT("200")},
+        {TEXT("CSSDamping"),TEXT("24")},{TEXT("CSSHandEnabled"),TEXT("true")},
+        {TEXT("CSSHandInputIsV43Compatible"),TEXT("false")}};
+    for (const auto& Pair : Defaults)
+        if (FBlueprintEditorUtils::FindNewVariableIndex(Blueprint,Pair.Key)==INDEX_NONE) return false;
+    for (const auto& Pair : Defaults)
+        Blueprint->NewVariables[FBlueprintEditorUtils::FindNewVariableIndex(Blueprint,Pair.Key)].DefaultValue=Pair.Value;
+    FBlueprintEditorUtils::MarkBlueprintAsModified(Blueprint);
+    FCompilerResultsLog Results;
+    FKismetEditorUtilities::CompileBlueprint(Blueprint,EBlueprintCompileOptions::None,&Results);
+    if (Results.NumErrors || Results.NumWarnings || !Blueprint->GeneratedClass) return false;
+    UObject* DefaultsObject=Blueprint->GeneratedClass->GetDefaultObject();
+    for (const auto& Pair : Defaults)
+    {
+        FProperty* Property=Blueprint->GeneratedClass->FindPropertyByName(Pair.Key);
+        if (!Property || !Property->ImportText_Direct(*Pair.Value,
+            Property->ContainerPtrToValuePtr<void>(DefaultsObject),DefaultsObject,PPF_None)) return false;
+    }
+    return true;
 }
 
