+FString UCSSControlRigLibrary::EvaluateHandPostProcessCandidate(USkeletalMesh* Mesh,
+    UAnimBlueprint* Blueprint,const FString& SnapshotJson,const TArray<FName>& Curves,bool CompatibleInput)
+{
+    auto Fail=[](const TCHAR* Why)->FString {
+        UE_LOG(LogCSSControlRig,Error,TEXT("Hand component: %s"),Why);return {};
+    };
+    if (!IsRunningCommandlet() || !Mesh || !Blueprint || !Blueprint->GeneratedClass ||
+        Blueprint->TargetSkeleton!=Mesh->GetSkeleton() ||
+        !Blueprint->GetPathName().StartsWith(TEXT("/Game/CSS/TransientProbes/ABP_CSS_ControlRigProbeHand")))
+        return Fail(TEXT("Invalid isolated component assets"));
+    FPoseSnapshot Snapshot;
+    if (!FJsonObjectConverter::JsonObjectStringToUStruct(SnapshotJson,&Snapshot) || !Snapshot.bIsValid ||
+        Snapshot.BoneNames.Num()!=Snapshot.LocalTransforms.Num()) return Fail(TEXT("Invalid source pose"));
+    const auto& Ref=Mesh->GetRefSkeleton();
+    if (Snapshot.BoneNames.Num()<Ref.GetRawBoneNum()) return Fail(TEXT("Incomplete source pose"));
+    FMemMark Mark(FMemStack::Get());
+    auto* Sequence=NewObject<UAnimSequence>(GetTransientPackage(),NAME_None,RF_Transient);
+    Sequence->SetSkeleton(Mesh->GetSkeleton());Sequence->SetRetargetSourceAsset(Mesh);Sequence->UpdateRetargetSourceAssetData();
+    auto& Controller=Sequence->GetController();Controller.InitializeModel();
+    Controller.OpenBracket(FText::FromString(TEXT("Hand integration source")),false);
+    Controller.SetFrameRate(FFrameRate(60,1),false);Controller.SetNumberOfFrames(FFrameNumber(1),false);
+    for (int32 Index=0;Index<Ref.GetRawBoneNum();++Index)
+    {
+        const FTransform& Input=Snapshot.LocalTransforms[Index];
+        if (Snapshot.BoneNames[Index]!=Ref.GetBoneName(Index) || Input.ContainsNaN() || !Input.GetRotation().IsNormalized())
+        { Controller.CloseBracket(false);return Fail(TEXT("Invalid source bone")); }
+        TArray<FVector3f> Positions,Scales;TArray<FQuat4f> Rotations;
+        Positions.Init(FVector3f(Ref.GetRefBonePose()[Index].GetTranslation()),2);
+        Scales.Init(FVector3f(Input.GetScale3D()),2);Rotations.Init(FQuat4f(Input.GetRotation()),2);
+        if (!Controller.AddBoneCurve(Ref.GetBoneName(Index),false) ||
+            !Controller.SetBoneTrackKeys(Ref.GetBoneName(Index),Positions,Rotations,Scales,false))
+        { Controller.CloseBracket(false);return Fail(TEXT("Cannot author source animation")); }
+    }
+    Controller.NotifyPopulated();Controller.CloseBracket(false);
+    Sequence->BeginCacheDerivedDataForCurrentPlatform();Sequence->WaitOnExistingCompression(true);
+    if (!Sequence->IsCompressedDataValid()) return Fail(TEXT("Source compression failed"));
+    FPreviewScene Scene(FPreviewScene::ConstructionValues().SetCreateDefaultLighting(false));
+    auto MakeComponent=[&]() {
+        auto* C=NewObject<USkeletalMeshComponent>();C->SetSkeletalMesh(Mesh);C->SetAnimationMode(EAnimationMode::AnimationSingleNode);
+        C->SetOverridePostProcessAnimBP(TSubclassOf<UAnimInstance>(Blueprint->GeneratedClass.Get()),true);
+        C->SetDisablePostProcessBlueprint(false);Scene.AddComponent(C,FTransform::Identity);C->InitAnim(true);
+        C->SetAnimation(Sequence);C->Stop();return C;
+    };
+    auto* Component=MakeComponent();auto* Upstream=MakeComponent();
+    auto* Filter=FindFProperty<FArrayProperty>(FAnimNode_ControlRigBase::StaticStruct(),TEXT("OutputBonesToTransfer"));
+    if (!Filter) return Fail(TEXT("Missing output filter"));
+    TArray<TSharedPtr<FJsonValue>> Samples;
+    for (int32 Frame=0;Frame<7;++Frame)
+    {
+        const bool Enabled=Frame==1 || Frame==2 || Frame==4 || Frame==6;
+        if (Frame==6) for (auto* C : {Component,Upstream})
+        { C->InitAnim(true);C->SetAnimation(Sequence);C->Stop(); }
+        for (auto* C : {Upstream,Component})
+        {
+            auto* Instance=C->GetPostProcessInstance();if (!Instance) return Fail(TEXT("Missing post-process instance"));
+            auto* Enable=FindFProperty<FBoolProperty>(Instance->GetClass(),TEXT("CSSHandEnabled"));
+            auto* Compatible=FindFProperty<FBoolProperty>(Instance->GetClass(),TEXT("CSSHandInputIsV43Compatible"));
+            if (!Enable || !Compatible) return Fail(TEXT("Missing hand controls"));
+            Enable->SetPropertyValue_InContainer(Instance,C==Component && Enabled);
+            Compatible->SetPropertyValue_InContainer(Instance,CompatibleInput);
+            for (const auto& Pair : {TPair<FName,float>(TEXT("CSSStiffness"),200.f),TPair<FName,float>(TEXT("CSSDamping"),24.f)})
+            {
+                auto* Property=FindFProperty<FFloatProperty>(Instance->GetClass(),Pair.Key);
+                if (!Property) return Fail(TEXT("Missing accepted hair settings"));
+                Property->SetPropertyValue_InContainer(Instance,Pair.Value);
+            }
+            C->SetPosition(0.f,false);C->TickAnimation(Frame==0 ? 0.f : 1.f/60,true);C->RefreshBoneTransforms();
+        }
+        auto* Instance=Component->GetPostProcessInstance();UControlRig* Hand=nullptr;int32 Nodes=0;
+        for (TFieldIterator<FStructProperty> It(Instance->GetClass());It;++It)
+        {
+            if (It->Struct!=FAnimNode_ControlRig::StaticStruct()) continue;
+            ++Nodes;auto* Node=It->ContainerPtrToValuePtr<FAnimNode_ControlRig>(Instance);
+            const auto& Bones=*Filter->ContainerPtrToValuePtr<TArray<FBoneReference>>(Node);
+            if (Bones.Num()==19) Hand=Node->GetControlRig();
+        }
+        if (Nodes!=3 || !Hand) return Fail(TEXT("Missing three native rig instances"));
+        auto Row=MakeShared<FJsonObject>();Row->SetNumberField(TEXT("frame"),Frame);Row->SetBoolField(TEXT("enabled"),Enabled);
+        Row->SetBoolField(TEXT("valid"),Hand->GetVariableAsString(TEXT("HandValid")).Equals(TEXT("True"),ESearchCase::IgnoreCase));
+        Row->SetStringField(TEXT("hand_inputs"),Hand->GetVariableAsString(TEXT("HandInputs")));
+        TArray<TSharedPtr<FJsonValue>> Input,Output,RigOutput;
+        const auto A=Upstream->GetBoneSpaceTransformsView(),B=Component->GetBoneSpaceTransformsView();
+        if (A.Num()!=Ref.GetNum() || B.Num()!=Ref.GetNum()) return Fail(TEXT("Incomplete evaluated pose"));
+        for (int32 Index=0;Index<Ref.GetRawBoneNum();++Index)
+        {
+            Input.Add(MakeShared<FJsonValueObject>(PoseJson(A[Index])));Output.Add(MakeShared<FJsonValueObject>(PoseJson(B[Index])));
+            RigOutput.Add(MakeShared<FJsonValueObject>(PoseJson(Hand->GetHierarchy()->GetLocalTransform(
+                FRigElementKey(Ref.GetBoneName(Index),ERigElementType::Bone)))));
+        }
+        Row->SetArrayField(TEXT("upstream"),Input);Row->SetArrayField(TEXT("output"),Output);Row->SetArrayField(TEXT("rig_output"),RigOutput);
+        auto Values=MakeShared<FJsonObject>();auto RigValues=MakeShared<FJsonObject>();auto MorphWeights=MakeShared<FJsonObject>();
+        for (FName Curve : Curves)
+        {
+            float Value=0;Component->GetCurveValue(Curve,0.f,Value);Values->SetNumberField(Curve.ToString(),Value);
+            RigValues->SetNumberField(Curve.ToString(),Hand->GetHierarchy()->GetCurveValue(FRigElementKey(Curve,ERigElementType::Curve)));
+            const int32* WeightIndex=Component->ActiveMorphTargets.Find(Mesh->FindMorphTarget(Curve));
+            if (WeightIndex && !Component->MorphTargetWeights.IsValidIndex(*WeightIndex)) return Fail(TEXT("Invalid active morph weight"));
+            MorphWeights->SetNumberField(Curve.ToString(),WeightIndex ? Component->MorphTargetWeights[*WeightIndex] : 0.f);
+        }
+        Row->SetObjectField(TEXT("curves"),Values);Row->SetObjectField(TEXT("rig_curves"),RigValues);
+        Row->SetObjectField(TEXT("morph_weights"),MorphWeights);Samples.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    auto Report=MakeShared<FJsonObject>();Report->SetArrayField(TEXT("samples"),Samples);
+    auto MetadataReport=MakeShared<FJsonObject>();
+    const auto* Metadata=Mesh->GetAssetUserData<UAnimCurveMetaData>();
+    for (FName Curve : Curves)
+    {
+        auto Flags=MakeShared<FJsonObject>();
+        const auto* MeshFlags=Metadata ? Metadata->GetCurveMetaData(Curve) : nullptr;
+        const auto* SkeletonFlags=Mesh->GetSkeleton()->GetCurveMetaData(Curve);
+        Flags->SetBoolField(TEXT("mesh_morph"),MeshFlags && MeshFlags->Type.bMorphtarget);
+        Flags->SetBoolField(TEXT("skeleton_morph"),SkeletonFlags && SkeletonFlags->Type.bMorphtarget);
+        MetadataReport->SetObjectField(Curve.ToString(),Flags);
+    }
+    Report->SetObjectField(TEXT("curve_metadata"),MetadataReport);
+    Report->SetBoolField(TEXT("compressed_source"),true);Report->SetBoolField(TEXT("compatible_input"),CompatibleInput);
+    FString Result;return FJsonSerializer::Serialize(Report,TJsonWriterFactory<>::Create(&Result)) ? Result : FString();
+}
