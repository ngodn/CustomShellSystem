+FString UCSSRetargetLibrary::InspectSkeletonMetadata(USkeleton* Skeleton)
+{
+    if (!Skeleton) return {};
+    TArray<UObject*> Objects;
+    GetObjectsWithOuter(Skeleton, Objects, true);
+    Objects.Add(Skeleton);
+    const FString Owner = Skeleton->GetPathName();
+    auto Report = MakeShared<FJsonObject>();
+    for (UObject* Object : Objects)
+    {
+        if (Object->HasAnyFlags(RF_Transient)) continue;
+        auto Fields = MakeShared<FJsonObject>();
+        Fields->SetStringField(TEXT("$class"), Object->GetClass()->GetPathName());
+        for (TFieldIterator<FProperty> It(Object->GetClass()); It; ++It)
+        {
+            if (It->HasAnyPropertyFlags(CPF_Transient)) continue;
+            FString Value;
+            It->ExportText_InContainer(0, Value, Object, Object, Object, PPF_None);
+            Fields->SetStringField(It->GetName(), Value.Replace(*Owner, TEXT("$SKELETON")));
+        }
+        Report->SetObjectField(Object->GetPathName().Replace(*Owner, TEXT("$SKELETON")), Fields);
+    }
+    FString Result;
+    return FJsonSerializer::Serialize(Report, TJsonWriterFactory<>::Create(&Result)) ? Result : FString();
+}
+
+USkeleton* UCSSRetargetLibrary::CreateReferenceRotationCandidate(USkeleton* Source,
+    USkeleton* Rotations, const FString& PackagePath)
+{
+    if (!IsRunningCommandlet() || !Source || !Rotations ||
+        Source->GetPathName() != TEXT("/Game/CSSAuthoring/Shared/Skeletons/SKEL_CSS_Base.SKEL_CSS_Base") ||
+        !Rotations->GetPathName().StartsWith(TEXT("/Game/CSSAuthoring/DiagnosticReferences/")) ||
+        !PackagePath.StartsWith(TEXT("/Game/CSSAuthoring/DiagnosticReferences/SKEL_B2GameReference")) ||
+        FPackageName::DoesPackageExist(PackagePath) || FindPackage(nullptr, *PackagePath)) return nullptr;
+    const auto& Original = Source->GetReferenceSkeleton();
+    const auto& Reference = Rotations->GetReferenceSkeleton();
+    if (Original.GetRawBoneNum() != 379 || Reference.GetRawBoneNum() != Original.GetRawBoneNum()) return nullptr;
+    for (int32 Index = 0; Index < Original.GetRawBoneNum(); ++Index)
+    {
+        if (Original.GetBoneName(Index) != Reference.GetBoneName(Index) ||
+            Original.GetParentIndex(Index) != Reference.GetParentIndex(Index) ||
+            !Reference.GetRawRefBonePose()[Index].GetRotation().IsNormalized()) return nullptr;
+    }
+    auto* Candidate = Cast<USkeleton>(StaticDuplicateObject(Source, CreatePackage(*PackagePath),
+        FName(*FPackageName::GetLongPackageAssetName(PackagePath))));
+    if (!Candidate) return nullptr;
+    {
+        FReferenceSkeletonModifier Modifier(Candidate);
+        for (int32 Index = 0; Index < Original.GetRawBoneNum(); ++Index)
+        {
+            FTransform Pose = Original.GetRawRefBonePose()[Index];
+            Pose.SetRotation(Reference.GetRawRefBonePose()[Index].GetRotation());
+            Modifier.UpdateRefPoseTransform(Index, Pose);
+        }
+    }
+    return Candidate;
+}
