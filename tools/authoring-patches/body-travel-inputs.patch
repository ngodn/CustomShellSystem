+        if ((RegionTravel==nullptr)!=(GlobalTravel==nullptr) ||
+            (RegionTravel && (RegionTravel->ArrayDim!=1 || !CastField<FFloatProperty>(RegionTravel->Inner))))
+            return Fail(TEXT("Body travel inputs do not match the native contract"));
+        if (Mode==TEXT("region_travel") && !RegionTravel) return Fail(TEXT("Travel fixture requires the travel contract"));
+        if (RegionTravel)
+        {
+            FScriptArrayHelper Values(RegionTravel,RegionTravel->ContainerPtrToValuePtr<void>(Instance));
+            if (Values.Num()!=7) return Fail(TEXT("Invalid region travel count"));
+            // Distinct per region, changing at one second, so a stale or shifted copy fails.
+            for (int32 Index=0;Index<7;++Index)
+                CastField<FFloatProperty>(RegionTravel->Inner)->SetPropertyValue(Values.GetRawPtr(Index),
