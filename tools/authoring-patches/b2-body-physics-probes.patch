+#pragma once
+
+#include "Kismet/BlueprintFunctionLibrary.h"
+#include "CSSPhysicsProbeLibrary.generated.h"
+
+/** Commandlet-only isolated body collision authoring and actual physics queries. */
+UCLASS()
+class UCSSPhysicsProbeLibrary : public UBlueprintFunctionLibrary
+{
+    GENERATED_BODY()
+public:
+    /** Creates a fresh diagnostic asset. Caller owns explicit saving. */
+    UFUNCTION(BlueprintCallable, Category="CSS|Authoring")
+    static class UPhysicsAsset* CreateBodyCandidate(class USkeletalMesh* Mesh,
+        const FString& DefinitionJson, const FString& PackagePath);
+
+    UFUNCTION(BlueprintCallable, Category="CSS|Authoring")
+    static FString InspectBodyCandidate(class UPhysicsAsset* Asset);
+
+    /** Transient component queries; optionally use the saved mesh binding and recreate physics. */
+    UFUNCTION(BlueprintCallable, Category="CSS|Authoring")
+    static FString ProbeBodyQueries(class USkeletalMesh* Mesh, class UPhysicsAsset* Asset,
+        const FString& QueriesJson, bool UseMeshBinding = false);
+
+    /** Normal animation-to-physics updates, or a bounded simulated fall, in an isolated world. */
+    UFUNCTION(BlueprintCallable, Category="CSS|Authoring")
+    static FString ProbeBodyMotion(class USkeletalMesh* Mesh, class UPhysicsAsset* Asset,
+        class UAnimSequence* Sequence, bool Simulate, int32 Fps = 60, int32 Frames = 120);
+};
