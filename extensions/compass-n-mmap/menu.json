{
  "schema": 1,
  "sections": [
    {
      "id": "compass",
      "title": "Compass",
      "controls": [
        {
          "id": "enabled",
          "type": "toggle",
          "label": "Show compass",
          "value": true,
          "description": "The heading tape across the top of the screen."
        },
        {
          "id": "scale",
          "type": "slider",
          "label": "Size",
          "value": 1.0,
          "min": 0.7,
          "max": 1.5,
          "step": 0.05,
          "description": "Idle size of the compass."
        },
        {
          "id": "opacity",
          "type": "slider",
          "label": "Opacity",
          "value": 1.0,
          "min": 0.25,
          "max": 1.0,
          "step": 0.05,
          "description": "Idle opacity of the compass."
        },
        {
          "id": "jog_scale",
          "type": "slider",
          "label": "Jog size",
          "value": 0.85,
          "min": 0.4,
          "max": 1.0,
          "step": 0.05,
          "description": "Fraction of the idle size while jogging."
        },
        {
          "id": "jog_opacity",
          "type": "slider",
          "label": "Jog opacity",
          "value": 0.5,
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "description": "Opacity while jogging."
        },
        {
          "id": "sprint_scale",
          "type": "slider",
          "label": "Sprint size",
          "value": 0.75,
          "min": 0.4,
          "max": 1.0,
          "step": 0.05,
          "description": "Fraction of the idle size while sprinting."
        },
        {
          "id": "sprint_opacity",
          "type": "slider",
          "label": "Sprint opacity",
          "value": 0.5,
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "description": "Opacity while sprinting."
        }
      ]
    },
    {
      "id": "minimap",
      "title": "Minimap",
      "controls": [
        {
          "id": "minimap_enabled",
          "type": "toggle",
          "label": "Show minimap",
          "value": false,
          "description": "A player-centered minimap in the corner, drawn from the game's own map tiles."
        },
        {
          "id": "minimap_size",
          "type": "slider",
          "label": "Size",
          "value": 200,
          "min": 100,
          "max": 600,
          "step": 10,
          "description": "Width/height of the minimap in pixels."
        },
        {
          "id": "minimap_zoom",
          "type": "slider",
          "label": "Map range (m)",
          "value": 1000,
          "min": 250,
          "max": 5000,
          "step": 250,
          "description": "How many meters across the minimap shows. Smaller = more zoomed in."
        },
        {
          "id": "minimap_orientation",
          "type": "choice",
          "label": "Orientation",
          "value": "camera",
          "options": [
            { "id": "north", "label": "North up" },
            { "id": "camera", "label": "Camera up" },
            { "id": "player", "label": "Player up" }
          ],
          "description": "Which way is up: fixed north, the camera's facing, or the player's facing."
        },
        {
          "id": "minimap_opacity",
          "type": "slider",
          "label": "Opacity",
          "value": 0.9,
          "min": 0.2,
          "max": 1.0,
          "step": 0.05,
          "description": "Idle opacity of the minimap."
        },
        {
          "id": "minimap_jog_scale",
          "type": "slider",
          "label": "Jog size",
          "value": 0.85,
          "min": 0.4,
          "max": 1.0,
          "step": 0.05,
          "description": "Fraction of idle size while jogging."
        },
        {
          "id": "minimap_jog_opacity",
          "type": "slider",
          "label": "Jog opacity",
          "value": 0.6,
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "description": "Opacity while jogging."
        },
        {
          "id": "minimap_sprint_scale",
          "type": "slider",
          "label": "Sprint size",
          "value": 0.75,
          "min": 0.4,
          "max": 1.0,
          "step": 0.05,
          "description": "Fraction of idle size while sprinting."
        },
        {
          "id": "minimap_sprint_opacity",
          "type": "slider",
          "label": "Sprint opacity",
          "value": 0.6,
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "description": "Opacity while sprinting."
        },
        {
          "id": "anim_minimap_jog",
          "type": "toggle",
          "label": "Jog animation",
          "value": true,
          "description": "Animate minimap size and opacity while jogging."
        },
        {
          "id": "anim_minimap_sprint",
          "type": "toggle",
          "label": "Sprint animation",
          "value": true,
          "description": "Animate minimap size and opacity while sprinting."
        }
      ]
    }
  ]
}
