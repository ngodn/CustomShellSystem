--- /dev/null
+++ b/CSSClothProbeComponent.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include "Components/SkeletalMeshComponent.h"
+#include "CSSClothProbeComponent.generated.h"
+
+UCLASS(Transient)
+class CSSAUTHORING_API UCSSClothProbeComponent : public USkeletalMeshComponent
+{
+    GENERATED_BODY()
+
+public:
+    bool CaptureClothCollisions(FClothCollisionData& OutCollisions)
+    {
+#if WITH_CLOTH_COLLISION_DETECTION
+        FindClothCollisions(OutCollisions);
+        return true;
+#else
+        return false;
+#endif
+    }
+};
